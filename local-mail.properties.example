# Copy this file to "local-mail.properties" (same folder) and fill in your SMTP details.
# local-mail.properties is git-ignored, so your password never gets committed.
#
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters below (no spaces).
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your.address@gmail.com
spring.mail.password=your16charapppassword
app.mail.from=your.address@gmail.com
